# Secrets: set real values in Railway Variables. Never commit keys.
HELIUS_API_KEY=
BIRDEYE_API_KEY=
VYBE_API_KEY=

# Optional RPC override. If blank and HELIUS_API_KEY is set, Helius mainnet RPC is used.
SOLANA_RPC_URL=

# Persistent state. On Railway, mount a Volume at /data.
SCOUT_STATE_PATH=/data/shark-state.json
SCOUT_REPORT_PATH=/data/latest-harvest.json
SCOUT_GAUNTLET_STATE_PATH=/data/gauntlet-state.json
SCOUT_GAUNTLET_PATH=/data/latest-gauntlet.json

# Harvest breadth.
HARVEST_TOKEN_LIMIT=40
HARVEST_TRADERS_PER_TOKEN=10
HARVEST_GLOBAL_WALLET_LIMIT=50
HARVEST_PROFILE_LIMIT=40

# Provider throttling.
BIRDEYE_MIN_INTERVAL_MS=1100
VYBE_CONCURRENCY=3

# Resumable gauntlet. Each run checkpoints after every concurrency wave.
GAUNTLET_BATCH_SIZE=30
GAUNTLET_CONCURRENCY=4
GAUNTLET_HELIUS_PAGES=3

PORT=3000
REQUEST_TIMEOUT_MS=15000
MAX_WATCHLIST=12
