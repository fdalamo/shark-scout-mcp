# Optional: Helius API key. Keep the real key in Railway Variables, never in GitHub.
HELIUS_API_KEY=

# Optional override. If HELIUS_API_KEY is set and SOLANA_RPC_URL is blank,
# Shark Scout automatically uses the Helius mainnet RPC endpoint.
SOLANA_RPC_URL=

PORT=3000
REQUEST_TIMEOUT_MS=15000
MAX_WATCHLIST=12
