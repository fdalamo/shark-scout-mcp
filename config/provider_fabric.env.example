# Shark Scout Provider Fabric v1 — safe default is OFF until keys/URLs are populated.
PROVIDER_FABRIC_ENABLED=false
PROVIDER_FABRIC_RPC_ORDER=chainstack,solana_tracker,alchemy,helius
PROVIDER_FABRIC_TIMEOUT_MS=25000
PROVIDER_FABRIC_STATE_PATH=/data/provider-fabric-state.json

# Bulk RPC — Chainstack Developer: 3M RU/month, 25 RPS. Paste the full Solana RPC endpoint URL.
CHAINSTACK_SOLANA_RPC_URL=
CHAINSTACK_MIN_INTERVAL_MS=50

# Secondary RPC — Solana Tracker Free: 500K credits/month, 10 general RPS, 2 WebSockets.
# Prefer pasting the full endpoint URL issued by Solana Tracker; API key fallback is also supported.
SOLANA_TRACKER_RPC_URL=
SOLANA_TRACKER_API_KEY=
SOLANA_TRACKER_MIN_INTERVAL_MS=120

# Tertiary/failover RPC — Alchemy Free: 30M CU/month, 300 CU/s. Paste full Solana HTTPS endpoint.
ALCHEMY_SOLANA_RPC_URL=
ALCHEMY_MIN_INTERVAL_MS=150

# Existing Helius remains canonical/fallback. Existing HELIUS_API_KEY and/or SOLANA_RPC_URL are reused.
PROVIDER_FABRIC_HELIUS_MIN_INTERVAL_MS=120

# Precision intelligence APIs. These are deliberately NOT used as bulk RPC.
NANSEN_API_KEY=
BIRDEYE_API_KEY=
MORALIS_API_KEY=

# Keep Birdeye broad discovery disabled initially. Existing targeted Birdeye bridge/enrichment may use BIRDEYE_API_KEY.
BIRDEYE_DISCOVERY_ENABLED=false

# Provider-specific daily/monthly budget controls for future enrichment workers.
NANSEN_DAILY_CREDIT_BUDGET=10
BIRDEYE_MONTHLY_CU_BUDGET=30000
MORALIS_DAILY_CU_BUDGET=40000

# Existing no-key market providers remain available:
# DexScreener core token/pair endpoints: 300 RPM; batch up to 30 token addresses.
# GeckoTerminal public API: 30 calls/minute.
